{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist/node",
    "rootDir": "src",
    "sourceMap": false
  },
  "include": ["src/core/**/*.ts", "src/main/**/*.ts"]
}
