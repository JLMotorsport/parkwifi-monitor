{
  "name": "parkwifi-monitor",
  "productName": "Park WiFi Monitor",
  "version": "0.1.4",
  "description": "Background monitor for the Priory Park airMAX backbone and access points",
  "author": "Jake Little",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/node/main/main.js",
  "scripts": {
    "dev": "npm run build:node && concurrently -k \"vite --config vite.config.mts\" \"electron . --dev\"",
    "build:ui": "vite build --config vite.config.mts",
    "build:node": "tsc -p tsconfig.node.json",
    "build": "npm run build:node && npm run build:ui",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "headless": "node dist/node/main/headless.js",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.jlmotorsport.parkwifimonitor",
    "productName": "Park WiFi Monitor",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ParkWiFiMonitor-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Park WiFi Monitor"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JLMotorsport",
        "repo": "parkwifi-monitor",
        "releaseType": "release"
      }
    ]
  }
}
